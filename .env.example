PORT=3000
# VPN mode: auto (default, non-blocking), none, or fau-eduvpn (required, Windows only).
VPN_MODE=auto
# Optional full path to eduVPN.Client.exe if installed outside standard Windows locations.
EDUVPN_CLIENT_PATH=
DOWNLOAD_DIR=./downloads
USER_DATA_DIR=./.browser-profile
# Empty = Playwright bundled Chromium; "msedge" = system Edge (blocked here by RemoteDebuggingAllowed=0)
BROWSER_CHANNEL=
PLAYWRIGHT_HEADLESS=false
HUMAN_VERIFICATION_TIMEOUT_MS=300000
# Elsevier TDM API (https://dev.elsevier.com). Full text needs institutional IP or an insttoken.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
# Local Zotero API is the default. Set to web only for the legacy Web API.
ZOTERO_API_MODE=local
# Used only when ZOTERO_API_MODE=web.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user
