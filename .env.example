PORT=3000
# VPN mode: auto (default, non-blocking), none, eduvpn (required), or external (non-blocking).
VPN_MODE=auto
# Optional exact names for eduVPN on Windows. Server/profile restrictions require an exact adapter name.
EDUVPN_CLIENT_PATH=
EDUVPN_ADAPTER_NAME=
EDUVPN_SERVER_NAME=
EDUVPN_PROFILE_NAME=
# Optional external VPN executables; arguments must be JSON arrays of strings.
# Status exit code: 0 connected, 1 disconnected, anything else unknown.
VPN_STATUS_EXECUTABLE=
VPN_STATUS_ARGS_JSON=[]
VPN_CONNECT_EXECUTABLE=
VPN_CONNECT_ARGS_JSON=[]
DOWNLOAD_DIR=./downloads
USER_DATA_DIR=./.browser-profile
# Empty = Playwright bundled Chromium; "msedge" = system Edge.
BROWSER_CHANNEL=
PLAYWRIGHT_HEADLESS=false
HUMAN_VERIFICATION_TIMEOUT_MS=300000
# Elsevier TDM API (https://dev.elsevier.com). Full text needs institutional IP or an insttoken.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
# Local Zotero API is the default. Set to web only for the legacy Web API.
ZOTERO_API_MODE=local
# Used only when ZOTERO_API_MODE=web.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user
